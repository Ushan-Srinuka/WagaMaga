# Reference only. Run scripts/configure_local.py to create ignored .env with
# generated local credentials. Never use these placeholders outside examples.
APP_ENV=development
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
POSTGRES_USER=wagamaga_bootstrap
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_PORT=55432
APP_DB_USER=wagamaga_app
APP_DB_PASSWORD=replace-with-a-different-generated-password
APP_DB_NAME=wagamaga
TEST_DB_NAME=wagamaga_test
DATABASE_URL=postgresql+psycopg://wagamaga_app:replace-with-generated-local-password@127.0.0.1:55432/wagamaga
MIGRATION_DATABASE_URL=postgresql+psycopg://wagamaga_bootstrap:replace-with-generated-local-password@127.0.0.1:55432/wagamaga
TEST_DATABASE_URL=postgresql+psycopg://wagamaga_app:replace-with-generated-local-password@127.0.0.1:55432/wagamaga_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://wagamaga_bootstrap:replace-with-generated-local-password@127.0.0.1:55432/wagamaga_test
DOCUMENT_STORAGE_PATH=.data/documents
